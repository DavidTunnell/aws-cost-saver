# Required: Anthropic API key for Claude AI analysis
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required in production: 64 hex character encryption key for AWS credential storage
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: If this key is lost, encrypted AWS credentials in the DB become unreadable
MASTER_ENCRYPTION_KEY=

# Do not change these unless you know what you're doing
NODE_ENV=production
PORT=8000
